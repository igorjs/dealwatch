{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  // `fetcher/` is a separate Node project with its own tsconfig, and it
  // imports the Worker's shared parsers with explicit `.ts` extensions
  // (allowed there, not here). Without this exclude the Worker's own
  // type-check pulls those files in under the wrong compiler options and
  // fails on every one of them.
  "exclude": ["fetcher", "node_modules"]
}
